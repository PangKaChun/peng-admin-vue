# 页面标题
VUE_APP_TITLE = PENG ADMIN

# 生产环境配置
ENV = 'production'

# PENG ADMIN/生产环境
VUE_APP_BASE_API = '/prod-api'

# OAuth2 客户端配置
VUE_APP_OAUTH_CLIENT_ID = 'peng-vue'
VUE_APP_OAUTH_CLIENT_SECRET = 'secret'

# OAuth2 authorization_code + PKCE
VUE_APP_OAUTH_AUTHORIZE_ENDPOINT = '/oauth2/authorize'
VUE_APP_OAUTH_REDIRECT_URI = '/oauth/callback'
VUE_APP_OAUTH_SCOPE = 'openid'
